{
  "name": "@holie/tools",
  "version": "0.25.0",
  "license": "MIT",
  "exports": {
    "./ai": "./ai.ts",
    "./talen": "./talen.ts",
    "./mcp-bundel": "./mcp-bundel.ts",
    "./telegram": "./telegram.ts",
    "./auth": "./auth.ts",
    "./html": "./html.ts",
    "./runslot": "./runslot.ts",
    "./mail": "./mail.ts",
    "./ics": "./ics.ts",
    "./formulier": "./formulier.ts",
    "./codes": "./codes.ts",
    "./beleid": "./beleid.ts",
    "./ai-beleid": "./ai-beleid.ts",
    "./nieuwsbrief": "./nieuwsbrief.ts"
  },
  "publish": {
    "include": [
      "ai.ts",
      "ai-beleid.ts",
      "beleid.ts",
      "talen.ts",
      "mcp-bundel.ts",
      "telegram.ts",
      "auth.ts",
      "html.ts",
      "runslot.ts",
      "mail.ts",
      "ics.ts",
      "formulier.ts",
      "codes.ts",
      "nieuwsbrief.ts",
      "sql/rate_limit_hit.sql",
      "sql/nieuwsbrief.sql",
      "README.md",
      "LICENSE"
    ]
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read --allow-write",
    "beleid": "deno run --allow-read --allow-write beleid/momentopname.ts",
    "publiceer": "deno run --allow-read --allow-env=HOLIE_AI_BELEID_SLEUTEL --allow-net=beleid.holie.be beleid/publiceer.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "exclude": [],
  "fmt": { "exclude": ["beleid/python/verwachting.json"] },
  "lint": { "exclude": ["beleid/python/"] }
}
