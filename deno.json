{
  "name": "@holie/tools",
  "version": "0.33.3",
  "license": "MIT",
  "exports": {
    "./ai": "./ai.ts",
    "./talen": "./talen.ts",
    "./mcp-bundel": "./mcp-bundel.ts",
    "./telegram": "./telegram.ts",
    "./auth": "./auth.ts",
    "./html": "./html.ts",
    "./runslot": "./runslot.ts",
    "./mail": "./mail.ts",
    "./ics": "./ics.ts",
    "./formulier": "./formulier.ts",
    "./codes": "./codes.ts",
    "./beleid": "./beleid.ts",
    "./ai-beleid": "./ai-beleid.ts",
    "./nieuwsbrief": "./nieuwsbrief.ts",
    "./login": "./login.ts",
    "./google-terug": "./google-terug.ts",
    "./velden": "./velden.ts",
    "./gebruikers": "./gebruikers.ts"
  },
  "publish": {
    "include": [
      "ai.ts",
      "ai-beleid.ts",
      "beleid.ts",
      "talen.ts",
      "mcp-bundel.ts",
      "telegram.ts",
      "auth.ts",
      "html.ts",
      "runslot.ts",
      "mail.ts",
      "ics.ts",
      "formulier.ts",
      "velden.ts",
      "codes.ts",
      "nieuwsbrief.ts",
      "sql/rate_limit_hit.sql",
      "sql/telegram_onaf.sql",
      "sql/nieuwsbrief.sql",
      "sql/velden.sql",
      "login.ts",
      "google-terug.ts",
      "gebruikers.ts",
      "sql/gebruikers.sql",
      "beleid/python/holie_ai_beleid.py",
      "beleid/python/holie_ai.py",
      "README.md",
      "LICENSE"
    ]
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read --allow-write",
    "beleid": "deno run --allow-read --allow-write beleid/momentopname.ts && deno fmt ai-beleid.ts",
    "publiceer": "deno run --allow-read --allow-env=HOLIE_AI_BELEID_SLEUTEL --allow-net=beleid.holie.be,billara-api.holie.be beleid/publiceer.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "react": "npm:react@^19.0.0",
    "@types/react": "npm:@types/react@^19.0.0",
    "react-dom": "npm:react-dom@^19.0.0",
    "@happy-dom/global-registrator": "npm:@happy-dom/global-registrator@^20.0.0"
  },
  "exclude": [],
  "fmt": { "exclude": ["beleid/python/verwachting.json"] },
  "lint": { "exclude": ["beleid/python/"] },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  }
}
